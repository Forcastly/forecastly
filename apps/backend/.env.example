# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLAlchemy async URL (psycopg 3 driver, matches docker-compose service).
DATABASE_URL=postgresql+psycopg://forecastly:forecastly@localhost:5432/forecastly
DB_ECHO=false

# Allowed CORS origins. JSON array or comma-separated list. Empty = disabled.
CORS_ORIGINS=["http://localhost:3000"]

# Clerk (external auth). Leave unset in development to use the dev auth fallback.
# Setting CLERK_SECRET_KEY activates real token verification and disables the
# dev fallback automatically (no other change needed).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: restrict accepted token origins (azp). Comma-separated. Recommended
# in production, e.g. https://app.yourdomain.com
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Development-only authentication fallback. Must be false in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_SUBJECT=dev-user
DEV_AUTH_EMAIL=dev@forecastly.local
