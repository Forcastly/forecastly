# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLAlchemy async URL (psycopg 3 driver, matches docker-compose service).
DATABASE_URL=postgresql+psycopg://forecastly:forecastly@localhost:5432/forecastly
DB_ECHO=false

# Allowed CORS origins. JSON array or comma-separated list. Empty = disabled.
CORS_ORIGINS=[]

# Clerk — leave unset in development; the dev auth fallback is used instead.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# Development-only authentication fallback. Must be false in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_SUBJECT=dev-user
DEV_AUTH_EMAIL=dev@forecastly.local
